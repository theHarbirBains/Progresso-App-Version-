NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Server-only service role key. NEVER expose this to the mobile app or any client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed origins, or * to allow all (development only).
CORS_ORIGIN=*

# Optional. Sentry DSN for this backend's Node.js project. Error tracking
# stays fully disabled until this is set. Not a secret in the traditional
# sense (it's a write-only ingestion URL), but keep it server-side anyway.
SENTRY_DSN=

# Optional. HMAC signing secret from RevenueCat's dashboard (Project
# Settings -> Integrations -> Webhooks -> your webhook -> enable signing).
# The webhook endpoint rejects all requests until this is set. A real
# secret — never expose this anywhere.
REVENUECAT_WEBHOOK_SECRET=

# Optional. API key from console.anthropic.com, used to estimate calories/
# macros from a natural-language food description (AI nutrition search).
# That feature stays disabled until this is set. A real secret — never
# expose this anywhere.
ANTHROPIC_API_KEY=

# Optional. A secret you generate yourself (any long random string), checked
# against the X-Internal-Secret header on POST /api/v1/notifications/send-daily
# -- the daily push-notifications job. This backend has no in-process
# scheduler, so something external (a free scheduled-HTTP-request service, or
# a scheduled GitHub Actions workflow) must be configured to call that route
# once a day with this same secret. The route rejects every request until
# this is set. A real secret — never expose this anywhere.
INTERNAL_NOTIFICATIONS_SECRET=
