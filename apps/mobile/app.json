{
  "expo": {
    "name": "Progresso",
    "slug": "progresso",
    "version": "1.0.0",
    "scheme": "progresso",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E1707"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harbirbains.progresso",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "6bf7f35b-5df8-4348-8d93-ebb1d81cb759"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#12110F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@sentry/react-native",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Progresso uses your photo library to let you set a profile picture or a machine photo.",
          "cameraPermission": "Progresso uses your camera to scan food barcodes and let you take a profile or machine photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Progresso uses your camera to scan food barcodes and let you take a profile or machine photo."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#12110F"
        }
      ],
      "expo-image",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.harbirbains.progresso.widgets",
          "groupIdentifier": "group.com.harbirbains.progresso",
          "widgets": [
            {
              "name": "NutritionToday",
              "displayName": "Today's Nutrition",
              "description": "Calories left today, with your protein, carbs and fat.",
              "ios": { "supportedFamilies": ["systemSmall", "systemMedium"] }
            },
            {
              "name": "NextWorkout",
              "displayName": "Next Workout",
              "description": "The next day of your split, or the workout you're doing.",
              "ios": { "supportedFamilies": ["systemSmall", "systemMedium"] }
            },
            {
              "name": "StepsToday",
              "displayName": "Today's Steps",
              "description": "Today's steps from Apple Health.",
              "ios": { "supportedFamilies": ["systemSmall"] }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Progresso reads your step count to show today's steps. It never writes to Apple Health, and your steps stay on your phone.",
          "NSHealthUpdateUsageDescription": "Progresso doesn't save anything to Apple Health. It only reads your step count to show today's steps.",
          "background": false
        }
      ]
    ]
  }
}
