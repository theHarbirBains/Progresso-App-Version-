EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL (apps/api), e.g. http://192.168.1.23:4000 for local
# dev — use your machine's LAN IP, not localhost, so it's reachable from
# Expo Go on a physical device. Required for Account Settings (profile
# read/update goes through the backend, not directly to Supabase).
EXPO_PUBLIC_API_BASE_URL=

# Optional. Sentry DSN for this app's React Native project. A DSN is a
# public, write-only ingestion URL — safe to ship in the client bundle by
# design, unlike an API key. Error tracking stays fully disabled until
# this is set.
EXPO_PUBLIC_SENTRY_DSN=
