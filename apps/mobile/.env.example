EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Sentry DSN for this app's React Native project. A DSN is a
# public, write-only ingestion URL — safe to ship in the client bundle by
# design, unlike an API key. Error tracking stays fully disabled until
# this is set.
EXPO_PUBLIC_SENTRY_DSN=
